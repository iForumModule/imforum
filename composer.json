{
    "name": "iforummodule/imforum",
    "description": "Community forum module for ImpressCMS 2.0, built on the ImpressCMS Persistable Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Imforum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "test:integration": "phpunit -c phpunit.integration.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
