parameters:
    level: 6
    paths:
        - src
    excludePaths:
        - src/language/*
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    # The ImpressCMS core is checked out next to the module in CI (see .github/workflows/ci.yml)
    # and only scanned for class and function signatures, never analysed.
    scanDirectories:
        - %env.ICMS_CORE_PATH%/libraries/icms
    scanFiles:
        - %env.ICMS_CORE_PATH%/include/functions.php
        - %env.ICMS_CORE_PATH%/include/cp_functions.php
        - %env.ICMS_CORE_PATH%/libraries/icms.php
    # Core docblocks that are narrower than the code they describe. The core
    # itself passes these types everywhere; casting in the module would only
    # hide that.
    ignoreErrors:
        -
            # icms_db_criteria_Item::__construct() documents string, renders any scalar
            message: '#^Parameter \#2 \$value of class icms_db_criteria_Item constructor expects string, int#'
            identifier: argument.type
        -
            # many core docblocks use "str" and "unknown_type", which are not types
            message: '#^Parameter \#\d \$\w+ of (method|class) icms_\w+(::\w+\(\)| constructor) expects (str|unknown_type), #'
            identifier: argument.type
        -
            # icms_ipf_Tree::getFirstChild() documents string; the tree is keyed by integer ids
            message: '#^Parameter \#1 \$key of method icms_ipf_Tree::getFirstChild\(\) expects string, int given\.$#'
            identifier: argument.type
        -
            # icms_db_legacy_IDatabase::queryF() documents a resource, but returns false when the query fails
            identifier: ternary.alwaysTrue
            path: src/include/onupdate.php
        -
            # icms_core_DataFilter::filterTextareaDisplay() documents bool switches but compares them
            # with != 0 and !== 0, so false would still convert line breaks: the post's 0/1 flags go in as they are
            message: '#^Parameter \#[2-5] \$(smiley|icode|image|br) of static method icms_core_DataFilter::filterTextareaDisplay\(\) expects bool, int given\.$#'
            identifier: argument.type
        -
            # formatTimestamp() documents a string, but takes the integer timestamps that every caller passes
            message: '#^Parameter \#1 \$time of function formatTimestamp expects string, int#'
            identifier: argument.type
        -
            # icms::$user is documented as an object, but it is null for guests
            identifier: ternary.alwaysTrue
            path: src/*.php
        -
            identifier: function.alreadyNarrowedType
            message: '#^Call to function is_object\(\) with icms_member_user_Object#'
